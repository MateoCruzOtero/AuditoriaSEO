# Copiá este archivo como .env.local y completá tus claves.
# Si dejás una clave vacía, esa parte corre en MODO DEMO (datos de ejemplo).

# DataForSEO: tu login y contraseña de API (https://app.dataforseo.com/api-access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Claude (Anthropic): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Tu marca: aparece en los informes
AGENCY_NAME=Mi Agencia
AGENCY_CONTACT=hola@miagencia.com

# --- Vigilancia de la competencia ---
# Dirección de tu changedetection.io (con docker compose: http://localhost:5000)
CHANGEDETECTION_URL=
# En changedetection: Settings → API → copiá la "API key"
CHANGEDETECTION_API_KEY=
# Opcional: avisos al instante cuando algo cambia (formato Apprise, separados por coma).
# Ejemplos: mailtos://usuario:clave@gmail.com  |  tgram://TOKEN/CHAT_ID
CHANGEDETECTION_NOTIFICATION_URLS=
# Contale a la IA quiénes son, para que las recomendaciones sean útiles
COMPANY_DESCRIPTION=Somos una clínica dental en Montevideo con 2 sedes; competimos por precio y atención rápida.
# Clave para automatizar el resumen semanal (ver README)
CRON_SECRET=
